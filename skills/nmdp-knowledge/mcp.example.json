{
  "mcpServers": {
    "lore": {
      "command": "/Users/you/.volta/bin/volta",
      "args": [
        "run",
        "--node",
        "24.8.0",
        "node",
        "/absolute/path/to/lore-mcp/dist/index.js"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "https://your-confluence-instance.example.com",
        "CONFLUENCE_TOKEN": "YOUR_CONFLUENCE_PAT_HERE"
      }
    },
    "matchsync-jimi": {
      "command": "/Users/you/.volta/bin/volta",
      "args": [
        "run",
        "--node",
        "24.8.0",
        "node",
        "/absolute/path/to/jimi/dist/index.js"
      ],
      "env": {
        "JIRA_URL": "https://your-jira-instance.example.com",
        "JIRA_TOKEN": "YOUR_JIRA_PAT_HERE"
      }
    },
    "gitlab-bethematch": {
      "command": "/Users/you/.volta/bin/volta",
      "args": [
        "run",
        "--node",
        "24.8.0",
        "node",
        "/absolute/path/to/gitlab-mcp/dist/index.js"
      ],
      "env": {
        "GITLAB_URL": "https://your-gitlab-instance.example.com",
        "GITLAB_TOKEN": "YOUR_GITLAB_PAT_HERE"
      }
    },
    "atlassian-confluence-dc": {
      "command": "/Users/you/.volta/bin/volta",
      "args": [
        "run",
        "--node",
        "24.8.0",
        "node",
        "/absolute/path/to/atlassian-confluence-dc-mcp/dist/index.js"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "https://your-confluence-instance.example.com",
        "CONFLUENCE_TOKEN": "YOUR_CONFLUENCE_PAT_HERE"
      }
    }
  }
}
